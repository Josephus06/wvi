# Company branding. Copy to client/.env and fill in.
#
# Vite inlines these at BUILD time, so set them before `npm run build` -- changing them on a
# running server has no effect. Everything here is read by client/src/config/company.js.

VITE_COMPANY_NAME="Your Company Inc."
VITE_COMPANY_SHORT="COMPANY"

# Dashboard greeting: "Good Day <demonym>"
VITE_COMPANY_DEMONYM="Team"

# Strapline under the company name on the login screen
VITE_COMPANY_TAGLINE=""

# Printed letterhead on Estimates and Warranty Certificates
VITE_COMPANY_ADDRESS1=""
VITE_COMPANY_ADDRESS2=""
VITE_COMPANY_PHONE=""
VITE_COMPANY_WEBSITE=""

# Bank accounts listed on the Estimate print-out. Separate each with a pipe.
# e.g. "BPI Savings # 0000-0000|BDO Checking # 1111-1111"
VITE_COMPANY_BANKS=""

# Absolute API URL for the packaged mobile (Capacitor) build, which has no dev-server proxy.
# Leave blank for web-only deployments.
VITE_NATIVE_API_BASE=""
